# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# CORS
CORS_ORIGIN=http://localhost:5173

# Admin
# Long random string used as a bearer token for admin-only endpoints.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Judge voting access
# Long random string that IS the private Judge QR link's token — the QR
# encodes this value directly as /judge-vote?jt=<this value>. Anyone with
# the link can reach the judge voting flow (one vote per device, same as
# audience). Generate the same way as ADMIN_API_KEY. Rotate and reprint
# the QR if this ever leaks.
JUDGE_ACCESS_TOKEN=

# Rate limiting
VOTE_RATE_LIMIT_WINDOW_MS=60000
VOTE_RATE_LIMIT_MAX=8

# Device token cookie
DEVICE_TOKEN_COOKIE_NAME=museum_device_token
